{
    "logging": {
        "level": 20
    },

    "nfc": {
        "path": "tty:serial0:pn532",
        "broadcast": true
    },

    "hap": {
        "port": 51926,
        "persist": "hap.state",
        "default": "locked",
        "gpio": {
            "pin": 18,
            "duration": 10
        }
    },

    "homekey": {
        "persist": "homekey.json",
        "express": true,
        "finish": "silver",
        "flow": "fast",
        "lock_timeout": 10
    }
}
